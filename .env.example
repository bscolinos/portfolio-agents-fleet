# ── portfolio-agents / research-fleet configuration (TEMPLATE) ─────────────
# Copy to `.env` and fill in real values. NEVER commit the filled-in .env.

# SingleStore workspace (Management-API provisioned)
SINGLESTORE_HOST=svc-xxxxxxxx-dml.aws-virginia-8.svc.singlestore.com
SINGLESTORE_PORT=3306
SINGLESTORE_USER=admin
SINGLESTORE_PASSWORD=__CHANGE_ME__
SINGLESTORE_DATABASE=portfolio_agents

# SingleStore-hosted Anthropic (Bedrock-compatible gateway) + Qwen embeddings
LLM_ENDPOINT=https://ai.us-east-1.cloud.singlestore.com/<project-id>/v1
SINGLESTORE_PROJECT_ID=<project-id>

OPUS_MODEL=claude-opus-4-6-xxxxx
SONNET_MODEL=claude-sonnet-4-5-xxxxx
HAIKU_MODEL=claude-haiku-4-5-xxxxx
EMBEDDING_MODEL=qwen3-4b-embedding-xxxxx

# Per-model bearer JWTs issued by the SingleStore endpoint
OPUS_KEY=__JWT__
SONNET_KEY=__JWT__
HAIKU_KEY=__JWT__
QWEN_KEY=__JWT__

# Aura Analyst — research agents reach the HOSTED PROXY (not the raw endpoint).
# The raw Aura key lives ONLY on the proxy host (see research_fleet/aura/).
ANALYST_PROXY_URL=http://<proxy-private-ip>:8799
ANALYST_PROXY_TOKEN=__SHARED_PROXY_TOKEN__

# Per-node identity (set on each research EC2)
AGENT_ID=research-01
AGENT_NAME=Momentum Researcher
AGENT_FOCUS=momentum
AGENT_MODEL=haiku
