# ── Aura Analyst proxy configuration (TEMPLATE) — lives on the proxy host ───
# Copy to /opt/aura-proxy/.env on the dedicated proxy EC2. NEVER commit filled-in.

# SingleStore (for audit + cache tables)
SINGLESTORE_HOST=svc-xxxxxxxx-dml.aws-virginia-8.svc.singlestore.com
SINGLESTORE_PORT=3306
SINGLESTORE_USER=admin
SINGLESTORE_PASSWORD=__CHANGE_ME__
SINGLESTORE_DATABASE=portfolio_agents

# The REAL Aura Analyst domain endpoint + key (kept ONLY here, never on agents)
ANALYST_CHAT_URL=https://apps.us-east-1.cloud.singlestore.com/v1/organizations/<org-id>/projects/<project-id>/analyst/chat
ANALYST_API_KEY=__AURA_JWT__

# Shared bearer the research agents present to THIS proxy (rotate freely)
PROXY_TOKEN=__RANDOM_TOKEN__

# Resilience tunables
PROXY_TIMEOUT_S=90
PROXY_MAX_RETRIES=2
PROXY_CACHE_TTL_S=900
PROXY_RATE_PER_MIN=30
CB_FAIL_THRESHOLD=5
CB_RESET_S=30
